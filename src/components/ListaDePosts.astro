---
import type { CollectionEntry } from 'astro:content';
import { SITE, formatDate, url } from '../lib/site';

interface Props {
	posts: CollectionEntry<'posts'>[];
	/** Nível do título de cada análise (h2 na lista, h3 na home) */
	nivel?: 2 | 3;
}

const { posts, nivel = 2 } = Astro.props;
const Titulo = nivel === 2 ? 'h2' : 'h3';
---

{
	posts.length === 0 ? (
		<div class="cartao vazio">
			{/* Um plano sem nenhum ponto: a contagem real de análises publicadas. */}
			<div class="plano" aria-hidden="true">
				<span>n = 0</span>
			</div>
			<div>
				<p>Nenhuma análise publicada ainda.</p>
				<p>
					Enquanto isso, veja o meu <a href={SITE.links.github}>perfil no GitHub</a>.
				</p>
			</div>
		</div>
	) : (
		<ol class="cartoes" reversed>
			{posts.map((post) => (
				<li class="cartao">
					<Titulo class="cartao-titulo">
						<a class="cartao-link traco-marca" href={url(`/posts/${post.id}/`)}>
							{post.data.title}
						</a>
					</Titulo>
					<p>{post.data.description}</p>
					<p class="dados">
						<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
						{post.data.tags.length > 0 && <>. Assuntos: {post.data.tags.join(', ')}.</>}
					</p>
					{post.data.draft && <p class="rascunho">Rascunho, visível só no modo de desenvolvimento.</p>}
				</li>
			))}
		</ol>
	)
}

<script>
	import { ligarGrade } from '../scripts/grade';
	ligarGrade();
</script>

<style>
	.cartoes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		gap: 1.25rem;
	}

	p {
		margin: 0.5rem 0 0;
	}

	.dados {
		color: var(--texto-suave);
		font-size: var(--t-0);
	}

	.rascunho {
		color: var(--marca);
		font-size: var(--t-0);
	}

	/* Estado vazio: um plano com eixos e nenhum ponto. */
	.vazio {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem 2rem;
		max-width: var(--medida-larga);
	}

	.vazio p:first-child {
		margin-top: 0;
		font-family: var(--fonte-titulo);
		font-weight: 600;
		font-size: var(--t-1-5);
	}

	.plano {
		width: 9rem;
		height: 6rem;
		border-left: var(--traco) solid var(--eixo);
		border-bottom: var(--traco) solid var(--eixo);
		display: grid;
		place-items: center;
		font-family: var(--fonte-titulo);
		font-size: var(--t-0);
		color: var(--texto-suave);
	}
</style>
