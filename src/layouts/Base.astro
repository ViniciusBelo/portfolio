---
import '../styles/global.css';
import { SITE, emailHref, getPosts, getProjetos, url } from '../lib/site';
// Arquivo da Archivo (latin, eixos de peso e largura) usado no nome, na navegação e nos títulos.
// Pré-carregado para o nome não trocar de fonte depois de aparecer.
import archivoLatinWdth from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	/** 'article' nas páginas de post, para o Open Graph */
	type?: 'website' | 'article';
	image?: string;
	noindex?: boolean;
}

const { title, description = SITE.description, type = 'website', image, noindex = false } =
	Astro.props;

const fullTitle = title ? `${title} | ${SITE.author}` : `${SITE.author}, análise de dados`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const path = Astro.url.pathname.replace(/\/$/, '');
// Na home o nome é o h1 do gráfico; nas internas, a assinatura do cabeçalho (o nome aparece uma vez por página).
const naHome = path === url('/').replace(/\/$/, '');
// Sem análise publicada, "Análises" sai da navegação e a frase sobre citação sai do rodapé.
const temPosts = (await getPosts()).length > 0;
// Projetos ficam na home (âncora #projetos); o link aparece quando há algum cadastrado.
const temProjetos = (await getProjetos()).length > 0;
const nav = [
	...(temProjetos ? [{ href: url('/#projetos'), label: 'Projetos', match: '' }] : []),
	...(temPosts ? [{ href: url('/posts/'), label: 'Análises', match: url('/posts') }] : []),
	{ href: url('/sobre/'), label: 'Sobre', match: url('/sobre') },
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="preload" href={archivoLatinWdth} as="font" type="font/woff2" crossorigin />
		<meta name="theme-color" content="#0f1f28" />
		{/* Antes da pintura: marca que há JS (para o fluxo da home reservar altura sem pular depois) e aplica a cor de série escolhida. */}
		<script is:inline>
			(function () {
				var d = document.documentElement;
				d.classList.add('js');
				try {
					var s = localStorage.getItem('serie');
					if (s) d.dataset.serie = s;
				} catch (e) {}
			})();
		</script>

		<meta property="og:type" content={type} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content={SITE.author} />
		<meta property="og:title" content={title ?? SITE.author} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="pular" href="#conteudo">Pular para o conteúdo</a>

		<header class="topo">
			<div class="topo-linha">
				{
					naHome ? (
						<span />
					) : (
						<a class="assinatura" href={url('/')} aria-label={`${SITE.author}, página inicial`}>
							{SITE.author}
						</a>
					)
				}
				<nav aria-label="Principal">
					<ul>
						{
							nav.map((item) => (
								<li>
									<a
										class="traco-marca"
										href={item.href}
										aria-current={item.match && path.startsWith(item.match) ? 'page' : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
						<li>
							<a class="contato" href={SITE.links.github} rel="me">GitHub</a>
						</li>
					</ul>
				</nav>
			</div>
		</header>

		<main id="conteudo">
			<slot />
		</main>

		<footer class="pe">
			<div class="pe-linha">
				<ul class="contatos">
					<li><a href={SITE.links.github} rel="me">GitHub</a></li>
					{SITE.links.linkedin && <li><a href={SITE.links.linkedin} rel="me">LinkedIn</a></li>}
					{emailHref && <li><a href={emailHref}>E-mail</a></li>}
				</ul>
				{temPosts && <p>Textos e análises podem ser citados com link para a fonte.</p>}
			</div>
		</footer>

	</body>
</html>

<style>
	/* body é o contexto de empilhamento: o gráfico da home (z-index -1) fica entre o fundo e o texto. */
	body {
		position: relative;
		z-index: 0;
	}

	.topo {
		view-transition-name: topo;
	}

	.topo-linha,
	.pe-linha {
		max-width: var(--pagina);
		margin: 0 auto;
		padding: 1.1rem var(--margem);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
	}

	.assinatura {
		font-family: var(--fonte-titulo);
		font-weight: 700;
		font-stretch: 112%;
		font-size: var(--t-1);
		color: var(--texto);
		text-decoration: none;
		letter-spacing: var(--aperto);
	}

	nav ul,
	.contatos {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1.5rem;
	}

	nav a {
		font-family: var(--fonte-titulo);
		font-weight: 500;
		font-stretch: 100%;
		color: var(--texto);
		text-decoration: none;
		padding-block: 0.2rem;
	}

	nav a:focus-visible,
	nav a[aria-current='page'] {
		color: var(--marca);
	}

	/* Contato sempre à mão, no canto de cima: o único botão contornado do cabeçalho. */
	nav .contato {
		display: inline-block;
		padding: 0.3rem 0.9rem;
		border: var(--traco) solid var(--marca);
		border-radius: var(--raio);
		color: var(--marca);
	}

	@media (hover: hover) {
		nav a:hover {
			color: var(--marca);
		}

		nav .contato:hover {
			background: var(--marca);
			color: var(--fundo);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		nav .contato {
			transition:
				background-color var(--dur-curta) var(--curva),
				color var(--dur-curta) var(--curva);
		}
	}

	@media (max-width: 24rem) {
		.topo-linha {
			column-gap: 1rem;
		}

		nav ul {
			column-gap: 1rem;
		}
	}

	main {
		display: block;
	}

	.pe {
		margin-top: var(--vao-largo);
	}

	.pe-linha {
		padding-block: 1.5rem 2.5rem;
		font-size: var(--t-0);
		color: var(--texto-suave);
		justify-content: flex-start;
	}

	.pe-linha p {
		margin: 0;
	}
</style>
