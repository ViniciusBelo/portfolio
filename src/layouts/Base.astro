---
import '../styles/global.css';
import { SITE, emailHref, getPosts, url } from '../lib/site';
// Arquivo da Archivo (latin, eixo de largura) usado no nome, na navegação e nos títulos.
// Pré-carregado para o nome não trocar de fonte depois de aparecer.
import archivoLatinWdth from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	/** 'article' nas páginas de post, para o Open Graph */
	type?: 'website' | 'article';
	image?: string;
	noindex?: boolean;
}

const { title, description = SITE.description, type = 'website', image, noindex = false } =
	Astro.props;

const fullTitle = title ? `${title} | ${SITE.author}` : `${SITE.author}, análise de dados`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const path = Astro.url.pathname.replace(/\/$/, '');
// Na home o nome é o h1 dentro da tarja; nas internas, a assinatura da tarja (o nome fica visível uma vez por página).
const naHome = path === url('/').replace(/\/$/, '');
// Sem análise publicada, "Análises" sai da navegação e a frase sobre citação sai do rodapé.
const temPosts = (await getPosts()).length > 0;
const nav = [
	...(temPosts ? [{ href: url('/posts/'), label: 'Análises', match: url('/posts') }] : []),
	{ href: url('/sobre/'), label: 'Sobre', match: url('/sobre') },
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="preload" href={archivoLatinWdth} as="font" type="font/woff2" crossorigin />
		<meta name="theme-color" content="#253e54" />

		<meta property="og:type" content={type} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content={SITE.author} />
		<meta property="og:title" content={title ?? SITE.author} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="pular" href="#conteudo">Pular para o conteúdo</a>

		<header class:list={['topo', { 'topo-home': naHome }]}>
			<div class="topo-linha">
				{
					naHome ? (
						<h1 class="nome">{SITE.author}</h1>
					) : (
						<a class="assinatura" href={url('/')} aria-label={`${SITE.author}, página inicial`}>
							{SITE.author}
						</a>
					)
				}
				<nav aria-label="Principal">
					<ul>
						{
							nav.map((item) => (
								<li>
									<a
										class="traco-marca"
										href={item.href}
										aria-current={path.startsWith(item.match) ? 'page' : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main id="conteudo">
			<slot />
		</main>

		<footer class="pe">
			<div class="pe-linha">
				<ul class="contatos">
					<li><a href={SITE.links.github} rel="me">GitHub</a></li>
					{SITE.links.linkedin && <li><a href={SITE.links.linkedin} rel="me">LinkedIn</a></li>}
					{emailHref && <li><a href={emailHref}>E-mail</a></li>}
				</ul>
				{temPosts && <p>Textos e análises podem ser citados com link para a fonte.</p>}
			</div>
		</footer>
	</body>
</html>

<style>
	.topo-linha,
	.pe-linha {
		max-width: var(--pagina);
		margin: 0 auto;
		padding: 1.1rem var(--margem);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 2rem;
	}

	/*
	 * Tarja de título da microficha: a faixa legível a olho nu no topo da ficha. Só no cabeçalho.
	 * Sem view-transition-name: entra no crossfade da página inteira (ver global.css), então a tarja
	 * alta da home e a baixa das internas trocam por opacidade, sem esticar o texto.
	 */
	.topo {
		background: var(--tarja);
	}

	/*
	 * Na home a tarja é o título da ficha: o nome (h1) e a navegação na mesma linha de base.
	 * Abaixo dela começa a folha zebrada.
	 */
	.topo-home .topo-linha {
		padding-block: var(--vao) var(--vao-curto);
	}

	.nome {
		font-size: var(--t-5);
		font-stretch: 125%;
		line-height: 1;
		overflow-wrap: break-word;
	}

	.assinatura {
		font-family: var(--fonte-titulo);
		font-weight: 700;
		font-stretch: 112%;
		font-size: var(--t-1);
		color: var(--luz);
		text-decoration: none;
		letter-spacing: var(--aperto);
	}

	nav ul,
	.contatos {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
	}

	/* Navegação: cor e sublinhado trocam na hora (a corrida do traço fica só nos títulos da lista). */
	nav a {
		font-family: var(--fonte-titulo);
		font-weight: 500;
		font-stretch: 100%;
		color: var(--luz);
		text-decoration: none;
		padding-block: 0.2rem;
		transition: none;
	}

	nav a:focus-visible,
	nav a[aria-current='page'] {
		color: var(--marca);
	}

	@media (hover: hover) {
		nav a:hover {
			color: var(--marca);
		}
	}

	/* Até 24rem (384px): vãos menores para nome + "Análises" + "Sobre" caberem numa linha em 360px. */
	@media (max-width: 24rem) {
		.topo-linha {
			column-gap: 1rem;
		}

		nav ul {
			column-gap: 1rem;
		}
	}

	main {
		display: block;
	}

	.pe {
		margin-top: calc(var(--vao) * 1.5);
	}

	.pe-linha {
		padding-block: 1.5rem 2.5rem;
		font-size: var(--t-0);
		color: var(--luz-suave);
	}

	.pe-linha p {
		margin: 0;
	}
</style>
